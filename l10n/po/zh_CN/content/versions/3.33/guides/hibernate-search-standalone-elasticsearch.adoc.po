"h!Changes applied\n"
"h!Changes safe from crash/power loss\n"
"h!Changes visible on search\n"
"\n"
"!async\n"
"!Best\n"
"^!icon:times[role=red]\n"
"^!icon:times[role=red]\n"
"^!icon:times[role=red]\n"
"\n"
"!write-sync (**default**)\n"
"!Medium\n"
"^!icon:check[role=lime]\n"
"^!icon:check[role=lime]\n"
"^!icon:times[role=red]\n"
"\n"
