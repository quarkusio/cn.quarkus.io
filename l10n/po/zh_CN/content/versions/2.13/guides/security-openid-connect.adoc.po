msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.authentication.cookie-force-secure]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.authentication.cookie-force-secure[quarkus.oidc.\"tenant\".authentication.cookie-force-secure]`\n"
"\n"
