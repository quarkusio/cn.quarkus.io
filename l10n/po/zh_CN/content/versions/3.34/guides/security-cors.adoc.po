msgid ""
"[[quarkus-vertx-http_quarkus-http-cors_quarkus-http-cors-return-exact-origins]] [.property-path]##link:#quarkus-vertx-http_quarkus-http-cors_quarkus-http-cors-return-exact-origins[`+++quarkus.http.cors.return-exact-origins+++`]##\n"
"config_property_copy_button:+++quarkus.http.cors.return-exact-origins+++[]\n"
"\n"
"\n"
"[.description]\n"
"--\n"
"Whether to return the exact request origin in the `Access-Control-Allow-Origin` response header.\n"
"\n"
"When set to `true` (the default), the filter echoes back the request's `Origin` header value. When set to `false` and `origins` is configured as `++*++`, the response will contain the literal `Access-Control-Allow-Origin: ++*++` instead of echoing the request origin. This is useful for public APIs where HTTP caching is important, as echoing the origin requires `Vary: Origin` and defeats shared caches.\n"
"\n"
"Note: When `++*++` is returned as the origin, `Access-Control-Allow-Credentials` is forced to `false` per the CORS specification.\n"
"\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_HTTP_CORS_RETURN_EXACT_ORIGINS+++[]\n"
"--"
msgstr ""

msgid ""
"[[quarkus-vertx-http_quarkus-http-cors_quarkus-http-cors-return-exact-origins]] [.property-path]##link:#quarkus-vertx-http_quarkus-http-cors_quarkus-http-cors-return-exact-origins[`+++quarkus.http.cors.return-exact-origins+++`]##\n"
"config_property_copy_button:+++quarkus.http.cors.return-exact-origins+++[]"
msgstr ""

msgid "Whether to return the exact request origin in the `Access-Control-Allow-Origin` response header."
msgstr ""

msgid "When set to `true` (the default), the filter echoes back the request's `Origin` header value. When set to `false` and `origins` is configured as `++*++`, the response will contain the literal `Access-Control-Allow-Origin: ++*++` instead of echoing the request origin. This is useful for public APIs where HTTP caching is important, as echoing the origin requires `Vary: Origin` and defeats shared caches."
msgstr ""

msgid "Note: When `++*++` is returned as the origin, `Access-Control-Allow-Credentials` is forced to `false` per the CORS specification."
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_HTTP_CORS_RETURN_EXACT_ORIGINS+++[]"
msgstr ""

