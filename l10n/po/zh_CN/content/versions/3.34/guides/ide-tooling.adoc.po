msgid "Quarkus Tools in your favorite IDE"
msgstr "在你喜欢的IDE中使用Quarkus扩展工具"

msgid "The following IDEs have support for the community developed Quarkus Tools:"
msgstr "以下IDE支持社区开发的Quarkus工具："

msgid "https://marketplace.visualstudio.com/items?itemName=redhat.vscode-quarkus[Quarkus Tools for Visual Studio Code]"
msgstr "link:https://marketplace.visualstudio.com/items?itemName=redhat.vscode-quarkus[用于Visual Studio Code的Quarkus工具]"

msgid "https://marketplace.eclipse.org/content/quarkus-tools[Quarkus Tools for Eclipse]"
msgstr "link:https://marketplace.eclipse.org/content/quarkus-tools[用于Eclipse的Quarkus工具]"

msgid "https://plugins.jetbrains.com/plugin/13234-quarkus/versions[Quarkus Tools for IntelliJ IDEA]"
msgstr "link:https://plugins.jetbrains.com/plugin/13234-quarkus/versions[用于IntelliJ IDEA的Quarkus工具]"

msgid "https://github.com/eclipse-che/che-devfile-registry/tree/main/devfiles/quarkus[Quarkus Tools for Eclipse Che]"
msgstr ""

msgid "In addition, IntelliJ IDEA has additional support for Quarkus in their Ultimate non-open source version."
msgstr "此外，IntelliJ IDEA在其闭源的Ultimate版本中对Quarkus有额外的支持。"

