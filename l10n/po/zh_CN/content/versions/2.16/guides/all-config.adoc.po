msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC_TOKEN_REFRESH_EXPIRED+++[]"
msgstr "环境变量：env_var_with_copy_button:QUARKUS_OIDC_TOKEN_REFRESH_EXPIRED[]"

