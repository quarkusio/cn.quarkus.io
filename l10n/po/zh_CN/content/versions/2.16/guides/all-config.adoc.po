msgid ""
"icon:lock[title=Fixed at build time] [[quarkus-smallrye-reactive-messaging-amqp_quarkus.amqp.devservices.service-name]]`link:#quarkus-smallrye-reactive-messaging-amqp_quarkus.amqp.devservices.service-name[quarkus.amqp.devservices.service-name]`\n"
"\n"
