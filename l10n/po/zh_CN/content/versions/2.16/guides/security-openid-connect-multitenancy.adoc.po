msgstr ""

msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.token.allow-opaque-token-introspection]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.token.allow-opaque-token-introspection[quarkus.oidc.\"tenant\".token.allow-opaque-token-introspection]`\n"
"\n"
"[.description]\n"
"--\n"
"Allow the remote introspection of the opaque tokens. Set this property to 'false' if only JWT tokens are expected.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__TOKEN_ALLOW_OPAQUE_TOKEN_INTROSPECTION+++[]\n"
"--"
msgstr ""

msgid "[[quarkus-oidc_quarkus.oidc.-tenant-.token.allow-opaque-token-introspection]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.token.allow-opaque-token-introspection[quarkus.oidc.\"tenant\".token.allow-opaque-token-introspection]`"
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__TOKEN_ALLOW_OPAQUE_TOKEN_INTROSPECTION+++[]"
msgstr ""

msgid ""
"[[quarkus-oidc_quarkus.oidc.-tenant-.token.verify-access-token-with-user-info]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.token.verify-access-token-with-user-info[quarkus.oidc.\"tenant\".token.verify-access-token-with-user-info]`\n"
"\n"
"[.description]\n"
"--\n"
"Indirectly verify that the opaque (binary) access token is valid by using it to request UserInfo. Opaque access token is considered valid if the provider accepted this token and returned a valid UserInfo. You should only enable this option if the opaque access tokens have to be accepted but OpenId Connect provider does not have a token introspection endpoint. This property will have no effect when JWT tokens have to be verified.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__TOKEN_VERIFY_ACCESS_TOKEN_WITH_USER_INFO+++[]\n"
"--"
msgstr ""

msgid "[[quarkus-oidc_quarkus.oidc.-tenant-.token.verify-access-token-with-user-info]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.token.verify-access-token-with-user-info[quarkus.oidc.\"tenant\".token.verify-access-token-with-user-info]`"
msgstr ""

msgid "Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__TOKEN_VERIFY_ACCESS_TOKEN_WITH_USER_INFO+++[]"
msgstr ""

