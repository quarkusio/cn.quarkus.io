"[[quarkus-oidc_quarkus.oidc.-tenant-.logout.extra-params-extra-params]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.logout.extra-params-extra-params[quarkus.oidc.\"tenant\".logout.extra-params]`\n"
"\n"
