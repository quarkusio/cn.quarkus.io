"\n"
"[.description]\n"
"--\n"
"The relative path of the Back-Channel Logout endpoint at the application.\n"
"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_OIDC__TENANT__LOGOUT_BACKCHANNEL_PATH+++[]\n"
"--"
msgstr ""

msgid "[[quarkus-oidc_quarkus.oidc.-tenant-.logout.backchannel.path]]`link:#quarkus-oidc_quarkus.oidc.-tenant-.logout.backchannel.path[quarkus.oidc.\"tenant\".logout.backchannel.path]`"
