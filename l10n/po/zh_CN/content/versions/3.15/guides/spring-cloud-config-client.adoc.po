msgstr "xref:spring-data-rest.adoc[Quarkus - Spring Data REST 扩展]"

msgid "xref:spring-security.adoc[Quarkus - Extension for Spring Security]"
msgstr "xref:spring-security.adoc[Quarkus - Spring Security 扩展]"

