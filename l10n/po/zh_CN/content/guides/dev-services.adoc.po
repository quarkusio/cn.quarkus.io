"\n"
"Environment variable: env_var_with_copy_button:+++QUARKUS_AMQP_DEVSERVICES_SHARED+++[]\n"
"--"
msgstr "[lock]  link:#quarkus-messaging-amqp_quarkus-amqp-devservices_quarkus-amqp-devservices-shared[quarkus.amqp.devservices.shared]config_property_copy_button:quarkus.amqp.devservices.shared[]"

